datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Authentication Models (NextAuth / Auth.js + Custom Credentials)
// -------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // For legacy / custom email+password authentication
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedOrgs        Organization[]    @relation("OrgOwner")
  workspaceMembers WorkspaceMember[]
  assignedIssues   Issue[]           @relation("IssueAssignee")
  createdIssues    Issue[]           @relation("IssueCreator")
  comments         Comment[]
  attachments      Attachment[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  leadProjects     Project[]         @relation("ProjectLead")
  projectMembers   ProjectMember[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------
// Multi-Tenant Hierarchy (Organization -> Workspace -> Project)
// -------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([ownerId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members      WorkspaceMember[]
  projects     Project[]
  labels       Label[]
  activityLogs ActivityLog[]
  banners      Banner[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole  @default(MEMBER)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// -------------------------------------------------------------
// Projects, Sprints, Issues & Collaborations
// -------------------------------------------------------------

enum ProjectRole {
  OWNER // Project Co-Owner / Lead: Full project control & settings
  EDITOR // Write Access: Create, update, move issues
  VIEWER // Read-Only Access: View-only
}

model Project {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  key           String // e.g. "TRIP", "DEV"
  description   String?   @db.Text
  leadId        String?
  lead          User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issueSequence Int       @default(0) // incremented atomically on issue creation
  color         String?   @default("#3b82f6")
  icon          String?   @default("FolderKanban")
  isPrivate     Boolean   @default(false) // Restricted to explicitly assigned project members
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  issues     Issue[]
  sprints    Sprint[]
  members    ProjectMember[]
  columns    BoardColumn[]
  banners    Banner[]
  repository ProjectRepository?
  cronLogs   CronExecutionLog[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectRepository {
  id            String    @id @default(cuid())
  projectId     String    @unique
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl       String    // e.g. "https://github.com/owner/repo"
  repoOwner     String    // e.g. "octocat"
  repoName      String    // e.g. "Hello-World"
  defaultBranch String    @default("main")
  accessToken   String?   // Encrypted GitHub PAT / Auth token
  aiScanEnabled Boolean   @default(true)
  cronSchedule  String?   @default("0 12 * * *") // Daily 12:00 PM
  lastScannedAt DateTime?
  status        String    @default("ACTIVE") // ACTIVE, ERROR, DISCONNECTED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
}

model Banner {
  id          String     @id @default(cuid())
  imageUrl    String
  sortOrder   Int        @default(0)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@index([projectId])
}

model BoardColumn {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // e.g. "QA Testing", "Design", "In Review"
  key       String // unique identifier per project e.g. "QA_TESTING", "TODO"
  color     String   @default("#737373")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(EDITOR)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  number    Int
  goal      String?  @db.Text
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues Issue[]

  @@index([projectId])
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectKey  String
  issueNumber Int
  title       String
  description String?       @db.Text
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  order       Float         @default(0.0) // Fractional indexing for instant drag & drop
  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User          @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  estimate    Int? // Story points
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
  labels       Label[]

  @@unique([projectId, issueNumber])
  @@index([projectId, status, order])
  @@index([assigneeId])
  @@index([creatorId])
}

model Label {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  description String?

  issues Issue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isAi      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([issueId])
  @@index([authorId])
}

model Attachment {
  id         String    @id @default(cuid())
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  publicId   String // Cloudinary asset id
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([issueId])
  @@index([commentId])
  @@index([uploaderId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  issueId     String?
  issue       Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      String // e.g., "STATUS_CHANGED", "ASSIGNED", "PRIORITY_CHANGED"
  details     Json // Stores before/after diffs & metadata
  createdAt   DateTime  @default(now())

  @@index([issueId])
  @@index([workspaceId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model CronExecutionLog {
  id              String    @id @default(cuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId     String
  triggerSource   String    @default("CRON") // CRON, MANUAL, WEBHOOK
  status          String    @default("SUCCESS") // SUCCESS, FAILED, RUNNING
  findingsCount   Int       @default(0)
  issuesCreated   Int       @default(0)
  durationMs      Int       @default(0)
  summary         String    @db.Text
  error           String?   @db.Text
  rawOutput       String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([projectId])
  @@index([workspaceId])
  @@index([createdAt])
}

