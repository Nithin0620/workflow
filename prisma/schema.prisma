datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Authentication Models (NextAuth / Auth.js + Custom Credentials)
// -------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // For legacy / custom email+password authentication
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedOrgs        Organization[]    @relation("OrgOwner")
  invitesSent      WorkspaceInvite[] @relation("InviteSender")
  workspaceMembers WorkspaceMember[]
  assignedIssues   Issue[]           @relation("IssueAssignee")
  createdIssues    Issue[]           @relation("IssueCreator")
  comments         Comment[]
  attachments      Attachment[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  leadProjects     Project[]         @relation("ProjectLead")
  projectMembers   ProjectMember[]
  tourProgress     TourProgress[]
  discussionMessages DiscussionMessage[]
  discussionReactions DiscussionReaction[]
  channelReads     UserChannelRead[]
  createdIssueLinks DiscussionIssueLink[]
  createdWhiteboards Whiteboard[]
  pushSubscriptions PushSubscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------
// Multi-Tenant Hierarchy (Organization -> Workspace -> Project)
// -------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([ownerId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  projects     Project[]
  labels       Label[]
  activityLogs ActivityLog[]
  banners      Banner[]
  cronJobs     CronJob[]
  discussionChannels DiscussionChannel[]
  whiteboards  Whiteboard[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole  @default(MEMBER)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// Pending email invitations to join a workspace. Accepted in three steps:
// 1) email link -> 2) sign in / register with the invited email -> 3) accept.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole  @default(MEMBER)
  token       String    @unique // unguessable accept token (32 random bytes hex)
  invitedById String
  invitedBy   User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([email])
}

// -------------------------------------------------------------
// Projects, Sprints, Issues & Collaborations
// -------------------------------------------------------------

enum ProjectRole {
  OWNER // Project Co-Owner / Lead: Full project control & settings
  EDITOR // Write Access: Create, update, move issues
  VIEWER // Read-Only Access: View-only
}

model Project {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  key           String // e.g. "TRIP", "DEV"
  description   String?   @db.Text
  leadId        String?
  lead          User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issueSequence Int       @default(0) // incremented atomically on issue creation
  color         String?   @default("#3b82f6")
  icon          String?   @default("FolderKanban")
  isPrivate     Boolean   @default(false) // Restricted to explicitly assigned project members
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  issues     Issue[]
  sprints    Sprint[]
  members    ProjectMember[]
  columns    BoardColumn[]
  banners    Banner[]
  repository ProjectRepository?
  cronLogs   CronExecutionLog[]
  cronJobs   CronJob[]
  discussionChannels DiscussionChannel[]
  whiteboards ProjectWhiteboard[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectRepository {
  id            String    @id @default(cuid())
  projectId     String    @unique
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl       String    // e.g. "https://github.com/owner/repo"
  repoOwner     String    // e.g. "octocat"
  repoName      String    // e.g. "Hello-World"
  defaultBranch String    @default("main")
  accessToken   String?   // Encrypted GitHub PAT / Auth token
  aiScanEnabled Boolean   @default(true)
  cronSchedule  String?   @default("0 12 * * *") // Daily 12:00 PM
  lastScannedAt DateTime?
  status        String    @default("ACTIVE") // ACTIVE, ERROR, DISCONNECTED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
}

model Banner {
  id          String     @id @default(cuid())
  imageUrl    String
  sortOrder   Int        @default(0)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
  @@index([projectId])
}

model BoardColumn {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // e.g. "QA Testing", "Design", "In Review"
  key       String // unique identifier per project e.g. "QA_TESTING", "TODO"
  color     String   @default("#737373")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(EDITOR)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  number    Int
  goal      String?  @db.Text
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues Issue[]

  @@index([projectId])
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectKey  String
  issueNumber Int
  title       String
  description String?       @db.Text
  status      IssueStatus   @default(TODO)
  priority    IssuePriority @default(MEDIUM)
  order       Float         @default(0.0) // Fractional indexing for instant drag & drop
  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User          @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  estimate    Int? // Story points
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
  labels       Label[]
  discussionLinks DiscussionIssueLink[]
  gitLinks     IssueGitLink[]

  @@unique([projectId, issueNumber])
  @@index([projectId, status, order])
  @@index([assigneeId])
  @@index([creatorId])
}

model Label {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  description String?

  issues Issue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isAi      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([issueId])
  @@index([authorId])
}

model Attachment {
  id         String    @id @default(cuid())
  issueId    String
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  publicId   String // Cloudinary asset id
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([issueId])
  @@index([commentId])
  @@index([uploaderId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  issueId     String?
  issue       Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      String // e.g., "STATUS_CHANGED", "ASSIGNED", "PRIORITY_CHANGED"
  details     Json // Stores before/after diffs & metadata
  createdAt   DateTime  @default(now())

  @@index([issueId])
  @@index([workspaceId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model TourProgress {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId  String // e.g. "board", "workspace", "dashboard", "analytics"
  seenAt  DateTime @default(now())

  @@unique([userId, tourId])
  @@index([userId])
}

model CronExecutionLog {
  id              String    @id @default(cuid())
  cronJobId       String?
  cronJob         CronJob?  @relation(fields: [cronJobId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId     String
  triggerSource   String    @default("CRON") // CRON, MANUAL, WEBHOOK
  status          String    @default("SUCCESS") // SUCCESS, FAILED, RUNNING
  findingsCount   Int       @default(0)
  issuesCreated   Int       @default(0)
  durationMs      Int       @default(0)
  summary         String    @db.Text
  error           String?   @db.Text
  rawOutput       String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([cronJobId])
  @@index([projectId])
  @@index([workspaceId])
  @@index([createdAt])
}

model CronJob {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?   @db.Text // What the user wants this job to do
  schedule      String    @default("0 12 * * *")
  jobType       String    @default("AI_SCAN") // AI_SCAN (reserved for future job types)
  enabled       Boolean   @default(true)
  repoOwner     String
  repoName      String
  defaultBranch String    @default("main")
  accessToken   String?
  lastStatus    String?
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  runs CronExecutionLog[]

  @@index([workspaceId])
  @@index([projectId])
}

// -------------------------------------------------------------
// Discussions, Channels & Chat Models
// -------------------------------------------------------------

enum ChannelType {
  TEXT
  ANNOUNCEMENT
}

model DiscussionChannel {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Optional linkage to a Project (null for Workspace-wide channels like #general)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name        String       // e.g. "backend", "frontend", "general"
  topic       String?      @db.Text
  type        ChannelType  @default(TEXT)
  isPrivate   Boolean      @default(false)
  position    Int          @default(0) // Ordering within category
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages    DiscussionMessage[]
  reads       UserChannelRead[]

  @@unique([workspaceId, projectId, name])
  @@index([workspaceId])
  @@index([projectId])
}

model DiscussionMessage {
  id          String              @id @default(cuid())
  channelId   String
  channel     DiscussionChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  authorId    String
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content     String              @db.Text
  
  // Threading support (Parent message -> replies)
  parentId    String?
  parent      DiscussionMessage?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     DiscussionMessage[] @relation("ThreadReplies")
  replyCount  Int                 @default(0)
  lastReplyAt DateTime?

  // System & AI flags
  isSystem    Boolean             @default(false)
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  attachments DiscussionAttachment[]
  reactions   DiscussionReaction[]
  issueLinks  DiscussionIssueLink[]

  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

// First-class connection between discussion messages/threads and issues
model DiscussionIssueLink {
  id          String            @id @default(cuid())
  messageId   String
  message     DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  issueId     String
  issue       Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  createdById String
  creator     User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@unique([messageId, issueId])
  @@index([issueId])
  @@index([messageId])
  @@index([createdById])
}

model DiscussionAttachment {
  id        String            @id @default(cuid())
  messageId String
  message   DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileSize  Int
  fileType  String
  fileUrl   String
  createdAt DateTime          @default(now())

  @@index([messageId])
}

model DiscussionReaction {
  id        String            @id @default(cuid())
  messageId String
  message   DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String            // e.g. "👍", "🚀", "👀"
  createdAt DateTime          @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model UserChannelRead {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId   String
  channel     DiscussionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt  DateTime          @default(now())

  @@unique([userId, channelId])
  @@index([channelId])
  @@index([userId])
}

// -------------------------------------------------------------
// Collaborative Whiteboards & Canvas Architecture (N:M Multi-Project)
// -------------------------------------------------------------

model Whiteboard {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  title       String
  description String?  @db.Text
  
  // Canvas element tree and viewport camera/background configuration
  data        Json     @default("[]") // Excalidraw / Canvas elements JSON
  appState    Json?    // Zoom, scroll, viewMode, activeTheme
  thumbnail   String?  @db.Text       // Base64 or Cloudinary preview thumbnail
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 2-Way Many-to-Many Linking with Projects
  projects    ProjectWhiteboard[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([createdAt])
}

model ProjectWhiteboard {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  whiteboardId String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  
  linkedAt     DateTime   @default(now())

  @@unique([projectId, whiteboardId])
  @@index([projectId])
  @@index([whiteboardId])
}

// -------------------------------------------------------------
// Git & Version Control Integrations (Branches, Commits, PRs)
// -------------------------------------------------------------

enum GitLinkType {
  BRANCH
  COMMIT
  PULL_REQUEST
}

enum GitItemStatus {
  OPEN
  MERGED
  CLOSED
}

model IssueGitLink {
  id            String         @id @default(cuid())
  issueId       String
  issue         Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  type          GitLinkType    // BRANCH, COMMIT, PULL_REQUEST
  title         String         // e.g. "feat: add user session token verification" or branch name
  url           String         // Direct GitHub URL
  refNumber     Int?           // PR number (e.g. 42)
  sha           String?        // Git commit SHA or branch HEAD SHA
  author        String?        // GitHub username or committer name
  authorAvatar  String?        // GitHub avatar URL
  status        GitItemStatus  @default(OPEN)
  
  repoOwner     String?        // GitHub repo owner e.g. "facebook"
  repoName      String?        // GitHub repo name e.g. "react"
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([issueId, type, url])
  @@index([issueId])
  @@index([type])
  @@index([status])
}



